{
    "info": {
        "_postman_id": "whatsapp-api-collection",
        "name": "WhatsApp API",
        "description": "Postman collection for the WhatsApp API server",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Health Check",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/",
                    "host": ["{{base_url}}"],
                    "path": [""]
                }
            },
            "response": []
        },
        {
            "name": "Check Authentication Status",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/auth/status",
                    "host": ["{{base_url}}"],
                    "path": ["auth", "status"]
                }
            },
            "response": []
        },
        {
            "name": "Get QR Code",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/auth/qrcode",
                    "host": ["{{base_url}}"],
                    "path": ["auth", "qrcode"]
                }
            },
            "response": []
        },
        {
            "name": "Check QR Code Availability",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{base_url}}/auth/qrcode/availability",
                    "host": ["{{base_url}}"],
                    "path": ["auth", "qrcode", "availability"]
                }
            },
            "response": []
        },
        {
            "name": "Send Text Message",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "name": "Content-Type",
                        "type": "text",
                        "value": "application/json"
                    },
                    {
                        "key": "X-API-Key",
                        "value": "{{api_key}}"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"phoneNumber\": \"+1234567890\",\n  \"message\": \"Hello World\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/message",
                    "host": ["{{base_url}}"],
                    "path": ["message"]
                }
            },
            "response": []
        },
        {
            "name": "Send Image Message",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "X-API-Key",
                        "value": "{{api_key}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "phoneNumber",
                            "value": "+1234567890",
                            "description": "Recipient phone number",
                            "type": "text"
                        },
                        {
                            "key": "media",
                            "type": "file",
                            "src": "/path/to/image/file",
                            "description": "Image file to send"
                        },
                        {
                            "key": "caption",
                            "value": "Check out this photo!",
                            "description": "Caption for the image",
                            "type": "text"
                        },
                        {
                            "key": "messageType",
                            "value": "image",
                            "description": "Type of media being sent",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{base_url}}/message",
                    "host": ["{{base_url}}"],
                    "path": ["message"]
                }
            },
            "response": []
        },
        {
            "name": "Send Video Message",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "X-API-Key",
                        "value": "{{api_key}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "phoneNumber",
                            "value": "+1234567890",
                            "description": "Recipient phone number",
                            "type": "text"
                        },
                        {
                            "key": "media",
                            "type": "file",
                            "src": "/path/to/video/file",
                            "description": "Video file to send"
                        },
                        {
                            "key": "caption",
                            "value": "Check out this video!",
                            "description": "Caption for the video",
                            "type": "text"
                        },
                        {
                            "key": "messageType",
                            "value": "video",
                            "description": "Type of media being sent",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{base_url}}/message",
                    "host": ["{{base_url}}"],
                    "path": ["message"]
                }
            },
            "response": []
        },
        {
            "name": "Send Attachment Message",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "X-API-Key",
                        "value": "{{api_key}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "phoneNumber",
                            "value": "+1234567890",
                            "description": "Recipient phone number",
                            "type": "text"
                        },
                        {
                            "key": "media",
                            "type": "file",
                            "src": "/path/to/document/file",
                            "description": "Document file to send"
                        },
                        {
                            "key": "caption",
                            "value": "Please review this document",
                            "description": "Caption for the document",
                            "type": "text"
                        },
                        {
                            "key": "messageType",
                            "value": "document",
                            "description": "Type of media being sent",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{base_url}}/message",
                    "host": ["{{base_url}}"],
                    "path": ["message"]
                }
            },
            "response": []
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [""]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [""]
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "api_key",
            "value": "",
            "type": "string"
        },
        {
            "key": "base64_image_data",
            "value": "",
            "type": "string"
        },
        {
            "key": "base64_video_data",
            "value": "",
            "type": "string"
        },
        {
            "key": "base64_document_data",
            "value": "",
            "type": "string"
        }
    ]
}
