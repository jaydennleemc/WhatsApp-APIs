# Server Configuration
PORT=3000

# WhatsApp Client Configuration
WHATSAPP_CLIENT_NAME=whatsapp-api

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Default Country Code (used if not specified in phone number)
DEFAULT_COUNTRY_CODE=1  # US country code, change as needed

# Base path for the API (optional)
BUILD_BASE_PATH=