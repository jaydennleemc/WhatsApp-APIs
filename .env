# Server Configuration
PORT=3000

# WhatsApp Client Configuration
WHATSAPP_CLIENT_NAME=whatsapp-api
WHATSAPP_SESSION_PATH=./session-data

# Logging Configuration
LOG_LEVEL=info
LOG_PATH=./logs

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Default Country Code (used if not specified in phone number)
DEFAULT_COUNTRY_CODE=1  # US country code, change as needed

# Database URI (example - add to .env.local for actual usage)
# MONGO_DB_URI=your_database_uri_here